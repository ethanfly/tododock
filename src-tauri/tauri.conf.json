{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoDock",
  "version": "0.1.0",
  "identifier": "com.tododock.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TodoDock",
        "width": 420,
        "height": 640,
        "minWidth": 340,
        "minHeight": 420,
        "center": true,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A local-first Todo dock that stays close and out of the way.",
    "longDescription": "TodoDock is a local-first desktop Todo application with Markdown, deadlines, reminders, global capture, always-on-top, edge snapping and auto-hide.",
    "category": "Productivity",
    "copyright": "Copyright © 2026 TodoDock contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "French",
          "German",
          "Spanish",
          "PortugueseBR",
          "Portuguese",
          "Russian",
          "Italian",
          "Dutch",
          "Arabic",
          "Turkish",
          "Ukrainian",
          "Swedish"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": ["zh-CN", "en-US", "zh-TW", "ja-JP", "ko-KR"]
      }
    }
  }
}

